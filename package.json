{
	"name": "deldoku",
	"private": true,
	"version": "1.3.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev-php.mjs up && vite dev",
		"build": "vite build",
		"preview": "node scripts/dev-php.mjs up && vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev:down": "node scripts/dev-php.mjs down"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^5.2.7",
		"@neoconfetti/svelte": "^2.2.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^25.0.3",
		"flag-icons": "7.2.3",
		"svelte": "^5.55.4",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"vite": "^8.0.10"
	}
}
