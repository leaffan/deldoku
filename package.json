{
	"name": "deldoku",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev-php.mjs up && vite dev",
		"build": "vite build",
		"preview": "node scripts/dev-php.mjs up && vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"dev:down": "node scripts/dev-php.mjs down"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.3.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"flag-icons": "7.6.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.1.6",
		"vitest": "^5.1.1"
	},
	"engines": {
		"node": "^22.17.0 || ^24.0.0 || >=26.0.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
