# Prevent directory browsing
Options -Indexes

# Allow access to JSON files only, everything else is denied (403)
# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "\.json$">
        Require all granted
    </FilesMatch>
</IfModule>
# Apache 2.2 (fallback if mod_authz_core is missing)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "\.json$">
        Order allow,deny
        Allow from all
    </FilesMatch>
</IfModule>
